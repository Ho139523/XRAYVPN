# VPN Appliance configuration
# Copy this file to config/.env only if you want to override defaults.
# DO NOT put secrets in this file.

# The 3X-UI image is pinned to the tested release (see scripts/04-install-xui.sh).
# Uncomment to use another one; newer releases may need installer changes.
#XUI_VERSION=latest
#XUI_IMAGE=ghcr.io/mhsanaei/3x-ui:latest
XUI_CONTAINER_NAME=3xui_app
XUI_DATA_DIR=/opt/vpn-appliance/data

XUI_PANEL_PORT=2053

VPN_PORT=443

REALITY_TARGET=www.microsoft.com:443
REALITY_SERVER_NAME=www.microsoft.com
REALITY_FINGERPRINT=chrome
REALITY_SPIDERX=/

REALITY_REMARK=Finance

CLIENT_EMAIL=my-phone
CLIENT_COMMENT=my-phone
CLIENT_LIMIT_IP=2
CLIENT_FLOW=xtls-rprx-vision

TIMEZONE=Asia/Tehran

# ---------------------------------------------------------------------------
# Content policy (see docs/content-policy.md)
# ---------------------------------------------------------------------------

# Block porn for every user. All DNS sent through the tunnel is answered by the
# family resolver below whatever resolver the client is set to, and matching
# hostnames are dropped.
POLICY_BLOCK_PORN=true
POLICY_FAMILY_DNS="1.1.1.3 1.0.0.3"
# Also block DNS-over-HTTPS / DNS-over-TLS to well-known public resolvers.
POLICY_BLOCK_DOH=true
# Xray domain syntax (domain:, full:, keyword:, geosite:). Space separated.
POLICY_EXTRA_BLOCK_DOMAINS=""
POLICY_ALLOW_DOMAINS=""

# Everything below only seeds a NEW user's starting policy. After that parents
# manage sites, places and other parents on the web page (see docs/content-policy.md).

# Starting "blocked while in a place" sites for each new VPN user: youtube, instagram.
POLICY_ZONE_APPS="youtube instagram"

# If set, every new user starts with a place called "network" that matches
# connections from these public IPs / CIDRs / DDNS names (home or library Wi-Fi).
POLICY_ZONE_SOURCE_IPS=""

# The location gate and parent page. They are reachable only through the VPN
# tunnel (Xray maps this address to 127.0.0.1:<port>).
POLICY_GATE_ENABLED=true
POLICY_GATE_PORT=9099
POLICY_GATE_VIRTUAL_IP=192.0.2.1

# How often the gate looks for new VPN users (to create their parent account)
# and re-resolves DDNS names.
POLICY_SYNC_SECONDS=60
